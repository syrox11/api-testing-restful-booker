{
  "name": "api-testing-restful-booker",
  "version": "1.0.0",
  "private": true,
  "description": "REST API test automation for Restful-Booker with Playwright (TypeScript) and Postman/Newman",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:postman": "newman run postman/restful-booker.postman_collection.json -e postman/restful-booker.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export newman/report.html",
    "report": "playwright show-report",
    "typecheck": "tsc"
  },
  "author": "Artiom Syrovatskyy Kovalyov",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^7.0.2"
  }
}
